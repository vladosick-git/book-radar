# Скопируйте в .env и заполните. Файл .env и каталог secrets/ не публикуются и не попадают в архив.
RADAR_MODE=server
RADAR_DOMAIN=radar.example.org
# Имена, по которым панель доступна; без этого запросы отклоняются.
RADAR_ALLOWED_HOSTS=radar.example.org
# Хеш пароля: docker compose run --rm api python -m backend.auth hash
RADAR_ADMIN_PASSWORD_HASH=
RADAR_SESSION_HOURS=12
RADAR_COOKIE_SECURE=1
# Ключ шифрования сессий профилей (один раз):
#   docker compose run --rm --no-deps --user root -v ./secrets:/out api sh -c 'python -m backend.protection keygen /out/vault.key && chown pwuser:pwuser /out/vault.key && chmod 600 /out/vault.key'
#   UID pwuser в образе noble не 1000 (UID 1000 занят пользователем ubuntu), поэтому chown по имени внутри контейнера.
# Копию ключа храните отдельно от резервных копий базы.
RADAR_VAULT_KEY_FILE=/run/radar/vault.key
RADAR_MAX_BROWSERS=1
RADAR_STALE_SECONDS=60
RADAR_BACKUP_KEEP=7
# Версия образа. При обновлении увеличьте; прежний образ остаётся для отката.
RADAR_VERSION=0.8.2
# Yandex Browser supports the NCA chain used by mdd.yandex.net; profiles remain private.
# Set both variables together. For bundled Chromium: chromium and an empty executable.
RADAR_BROWSER=yandex
RADAR_BROWSER_EXECUTABLE=/usr/bin/yandex-browser-stable
# Сколько автоматических копий базы перед обновлением хранить (каталог /data/backups).
RADAR_PREUPDATE_KEEP=5
# OCR текста на изображениях объявлений: off или tesseract (локально, без интернета). Языки — пакеты образа.
RADAR_OCR=tesseract
RADAR_OCR_LANGS=rus+eng
# Уведомления Telegram настраиваются в панели: «Журнал» → «Уведомления». Токен бота в .env не указывается.
